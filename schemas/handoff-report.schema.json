{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LawChaiHandoffReport",
  "type": "object",
  "required": [
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "objective",
    "scope",
    "changed_paths",
    "verification",
    "semantic_contract",
    "terminal_state",
    "exact_next_action"
  ],
  "properties": {
    "repository": {
      "type": "string"
    },
    "pr_number": {
      "type": ["integer", "null"]
    },
    "branch": {
      "type": "string"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "objective": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": ["allowed_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authorized_behaviours": {
          "type": "array",
          "items": { "type": "string" }
        },
        "excluded_behaviours": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["test_command", "test_result", "zero_test_guard", "typecheck_result", "build_result"],
      "properties": {
        "test_command": { "type": "string" },
        "test_result": { "type": "string" },
        "zero_test_guard": { "type": "string" },
        "typecheck_result": { "type": "string" },
        "lint_result": { "type": "string" },
        "build_result": { "type": "string" },
        "browser_journey_result": { "type": "string" }
      }
    },
    "semantic_contract": {
      "type": "object",
      "required": ["public_signatures_changed", "storage_schema_changed", "consumers_searched"],
      "properties": {
        "public_signatures_changed": { "type": "boolean" },
        "return_values_changed": { "type": "boolean" },
        "storage_schema_changed": { "type": "boolean" },
        "error_handling_changed": { "type": "boolean" },
        "persistence_reset_changed": { "type": "boolean" },
        "import_export_changed": { "type": "boolean" },
        "migration_changed": { "type": "boolean" },
        "consumers_searched": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "keyboard_only": { "type": "boolean" },
        "visible_focus": { "type": "boolean" },
        "reduced_motion": { "type": "boolean" },
        "zoom_200": { "type": "boolean" },
        "viewports_320_390": { "type": "boolean" },
        "no_horizontal_overflow": { "type": "boolean" },
        "touch_targets_44": { "type": "boolean" }
      }
    },
    "security_privacy_data": {
      "type": "object",
      "properties": {
        "secrets_exposed": { "type": "boolean" },
        "sensitive_real_data_used": { "type": "boolean" },
        "synthetic_data_disclosure": { "type": "string" }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rejected_alternatives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "terminal_state": {
      "type": "string",
      "enum": ["READY_PR", "[BLOCKED]", "UNCHANGED_FAILURE"]
    },
    "exact_next_action": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  }
}
